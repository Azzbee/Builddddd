# ---------------------------------------------------------------------------
# Lattice environment configuration. Copy to .env and fill in secrets.
# Nested settings use a double underscore: LATTICE_SIMILARITY__ALPHA=0.4
# ---------------------------------------------------------------------------

LATTICE_ENVIRONMENT=dev
# Offline demo: loads a synthetic, interconnected corpus at startup (no GROBID/LLM/DB).
LATTICE_DEMO_MODE=false
# Persistent backends: wire Postgres (pgvector) + Neo4j instead of in-memory stores.
LATTICE_PERSISTENT=false
LATTICE_WORKSPACE_ID=default
LATTICE_MAX_WORKSPACES=32
LATTICE_LOG_LEVEL=INFO
LATTICE_LOG_JSON=true
LATTICE_DATA_DIR=/data
LATTICE_CORS_ORIGINS=["http://localhost:3000"]
LATTICE_RATE_LIMIT_PER_MIN=240
LATTICE_MAX_UPLOAD_MB=50
LATTICE_INGEST_MAX_ATTEMPTS=3
LATTICE_READINESS_TIMEOUT_S=2.0

# Single-user bearer token. Required when LATTICE_ENVIRONMENT=prod.
# Leave empty only for local development.
LATTICE_AUTH_TOKEN=

# Next.js proxy target when exported or copied to web/.env.local.
# Docker Compose overrides this to http://api:8000.
LATTICE_API_BASE=http://localhost:8000
# Same-origin proxy request cap. Keep above LATTICE_MAX_UPLOAD_MB for multipart overhead.
LATTICE_PROXY_MAX_BODY_MB=52

# --- Datastores (defaults match docker-compose service names) ---
LATTICE_NEO4J__URI=bolt://neo4j:7687
LATTICE_NEO4J__USER=neo4j
LATTICE_NEO4J__PASSWORD=lattice-dev-password
LATTICE_POSTGRES__DSN=postgresql://lattice:lattice@postgres:5432/lattice
LATTICE_REDIS__URL=redis://redis:6379/0

# --- Parsing services ---
LATTICE_GROBID__URL=http://grobid:8070
LATTICE_DOCLING__ENABLED=true
LATTICE_DOCLING__VISION_ENABLED=true
LATTICE_DOCLING__VISION_MODEL=claude-sonnet-4-6

# --- LLM providers (LiteLLM reads these provider-native vars) ---
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# --- Enrichment APIs ---
LATTICE_ENRICHMENT__S2_API_KEY=
LATTICE_ENRICHMENT__OPENALEX_MAILTO=you@example.com

# OPENAI_API_KEY is also read by LiteLLM when an OpenAI model is configured.
OPENAI_API_KEY=

# --- Similarity weights (override to tune; see docs/SIMILARITY.md) ---
LATTICE_SIMILARITY__ALPHA=0.40
LATTICE_SIMILARITY__BETA=0.25
LATTICE_SIMILARITY__GAMMA=0.25
LATTICE_SIMILARITY__DELTA=0.10
LATTICE_SIMILARITY__TAU=0.35

# --- Cost ceilings ---
LATTICE_COST__PER_JOB_USD_CAP=1.00
LATTICE_COST__DAILY_USD_CAP=50.00
