# ---------------------------------------------------------------------------
# Lattice environment configuration. Copy to .env and fill in secrets.
# Nested settings use a double underscore: LATTICE_SIMILARITY__ALPHA=0.4
# ---------------------------------------------------------------------------

LATTICE_ENVIRONMENT=dev
LATTICE_WORKSPACE_ID=default
LATTICE_LOG_LEVEL=INFO
LATTICE_LOG_JSON=true
LATTICE_DATA_DIR=/data

# Single-user auth bearer token (generate a long random string for prod).
LATTICE_AUTH_TOKEN=change-me

# --- Datastores (defaults match docker-compose service names) ---
LATTICE_NEO4J__URI=bolt://neo4j:7687
LATTICE_NEO4J__USER=neo4j
LATTICE_NEO4J__PASSWORD=lattice-dev-password
LATTICE_POSTGRES__DSN=postgresql://lattice:lattice@postgres:5432/lattice
LATTICE_REDIS__URL=redis://redis:6379/0

# --- Parsing services ---
LATTICE_GROBID__URL=http://grobid:8070

# --- LLM providers (LiteLLM reads these provider-native vars) ---
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# --- Enrichment APIs ---
LATTICE_ENRICHMENT__S2_API_KEY=
LATTICE_ENRICHMENT__OPENALEX_MAILTO=you@example.com

# --- Embeddings ---
# Optional hosted embedding providers (otherwise local sentence-transformers).
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Email digest (optional) ---
RESEND_API_KEY=

# --- Similarity weights (override to tune; see docs/SIMILARITY.md) ---
LATTICE_SIMILARITY__ALPHA=0.40
LATTICE_SIMILARITY__BETA=0.25
LATTICE_SIMILARITY__GAMMA=0.25
LATTICE_SIMILARITY__DELTA=0.10
LATTICE_SIMILARITY__TAU=0.35

# --- Cost ceilings ---
LATTICE_COST__PER_JOB_USD_CAP=1.00
LATTICE_COST__DAILY_USD_CAP=50.00
